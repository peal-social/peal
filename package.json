{
  "name": "peal",
  "private": true,
  "homepage": "https://peal.social",
  "bugs": "https://github.com/peal-social/peal/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peal-social/peal.git"
  },
  "workspaces": [
    "packages/*",
    "packages/peal-infra/pulumi"
  ],
  "type": "module",
  "scripts": {
    "prepare": "bun scripts/patch-typescript.ts",
    "references": "bun scripts/references.ts",
    "check": "nx run-many -t typegen && ultracite check",
    "fix": "ultracite fix",
    "typecheck": "bun scripts/patch-typescript.ts --strict && tsc --noEmit -p . && nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "sdk:generate": "nx run-many -t sdk:generate",
    "sdk:build": "nx run-many -t sdk:build",
    "sdk:check": "nx run peal-sdk:check",
    "sdk:test": "nx run-many -t sdk:test",
    "nx": "nx"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@types/bun": "1.4.5",
    "@types/node": "26.6.6",
    "effect": "4.1.4",
    "fern-api": "5.225.0",
    "nx": "24.0.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "ultracite": "8.2.1"
  },
  "overrides": {
    "@posthog/browser-common": "0.12.0",
    "@posthog/core": "1.68.0",
    "@posthog/types": "1.425.1"
  },
  "engines": {
    "bun": "1.4.4",
    "node": ">=26.13.0"
  },
  "packageManager": "bun@1.4.4"
}
