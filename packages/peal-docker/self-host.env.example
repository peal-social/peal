# Settings for a self-hosted Peal (compose.production.yaml with
# compose.self-host.yaml). Copy this file outside the repository, such as to
# /srv/peal/peal.env, readable by root only (chmod 600), and fill it in. The
# docs' self-hosting and environment variables pages explain each setting.
# Values shown are examples.

# The address people open Peal at, and its host name for Caddy's certificate.
PUBLIC_URL=https://peal.example.com
PEAL_DOMAIN=peal.example.com
# The marketing site's and the docs' host names, if you serve them too (the
# static profile, and their blocks in self-host/Caddyfile uncommented).
# PEAL_SITE_DOMAIN=www.example.com
# PEAL_DOCS_DOMAIN=docs.example.com
# Read when the static and docs images are built: the docs' address, and
# the web app's, which their sidebar links to.
# DOCS_SITE_URL=https://docs.example.com
# DOCS_APP_URL=https://peal.example.com
# The docs' assistant, off unless a model is named: the docs then run as a
# Node server (start the stack with --profile docs too, and use the docs
# server's block in self-host/Caddyfile), which answers with this Anthropic
# key. A Turnstile widget for the docs' host name checks each reader before
# a question, with its site key at build time and its secret at runtime.
# DOCS_ASSISTANT_MODEL=claude-haiku-5-5
# DOCS_ANTHROPIC_API_KEY=
# DOCS_TURNSTILE_SITE_KEY=
# DOCS_TURNSTILE_SECRET_KEY=
# Caddy replaces X-Forwarded-For with the address it sees. The docs server
# counts its assistant's readers by it too.
AUTH_IP_HEADERS=x-forwarded-for

# Secrets: generate each once, keep them, and never share them.
#   POSTGRES_PASSWORD        openssl rand -hex 32 (it goes in a URL)
#   BETTER_AUTH_SECRET       openssl rand -base64 32
#   PEAL_TOKEN_KEYS          k1:$(openssl rand -base64 32)
#   GRAFANA_ADMIN_PASSWORD   openssl rand -hex 24
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
PEAL_TOKEN_KEYS=
GRAFANA_ADMIN_PASSWORD=

# Email: who it comes from, and SMTP_URL or RESEND_API_KEY.
MAIL_FROM=Peal <noreply@example.com>
SMTP_URL=smtp://user:password@mail.example.com:587

# The media store: any S3-compatible API. On Cloudflare R2, for a bucket
# created in the EU jurisdiction, which cannot change afterwards:
# https://<account>.eu.r2.cloudflarestorage.com. Elsewhere, set
# PEAL_S3_REGION to the store's region where it asks for one.
PEAL_S3_ENDPOINT=https://s3.example.com
PEAL_S3_BUCKET=peal-media
PEAL_S3_ACCESS_KEY_ID=
PEAL_S3_SECRET_ACCESS_KEY=
# The server also keeps there, under erasures/, the id and time of each
# deleted account and workspace, to delete them again after a restored
# backup (the docs' self-hosting page, "Deletions and backups"). Name a
# private bucket for it if your media bucket is served publicly.
# PEAL_ERASURE_LEDGER_BUCKET=peal-erasures

# Optional: the hourly sweeps of the media folder. An upload never
# completed, a multipart upload left open and a file no media holds go
# once this old (each at least 7 hours), 500 of each a run at most (the
# docs' media storage page, "Unfinished uploads"). Set PEAL_MEDIA_SWEEPS
# to off before starting on a restored database, until the restore is
# final. The orphan sweep stops, deleting nothing, on a page of the bucket
# with more than PEAL_MEDIA_SWEEP_ORPHANS_LIMIT files the database does
# not know of, and the pending sweep when more than
# PEAL_MEDIA_SWEEP_PENDING_LIMIT workspaces have uploads never completed.
# Raise a limit for a run to clear its breaker once the database is sound.
# PEAL_MEDIA_SWEEPS=on
# PEAL_MEDIA_SWEEP_ORPHANS_LIMIT=100
# PEAL_MEDIA_SWEEP_PENDING_LIMIT=100
# PEAL_MEDIA_SWEEP_PENDING_AFTER=1 day
# PEAL_MEDIA_SWEEP_UPLOADS_AFTER=1 day
# PEAL_MEDIA_SWEEP_ORPHANS_AFTER=1 day
# PEAL_MEDIA_SWEEP_BATCH=500

# Optional: delete the lines you do not use. A line left empty sets an empty
# value, which is not the same as unset.
# BLUESKY_CLIENT_KEYS=
# The platforms' apps, each id with its secret (the docs' self-hosting
# page says how to make them). Meta's main app connects Facebook Pages and
# Instagram through a Page; its Instagram credentials connect Instagram
# professional accounts with Instagram Login, the default way in.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# A second LinkedIn app, with the Community Management API alone, connects
# company pages.
# LINKEDIN_PAGES_CLIENT_ID=
# LINKEDIN_PAGES_CLIENT_SECRET=
# Optional: the calls the inbox's reads of pages' comments may make a day,
# for the app and for one member, who connected the page (200 and 40 by
# default, out of the
# Development tier's 500 and 100 a member, posting included). Raise both
# on the Standard tier.
# LINKEDIN_DAILY_COMMENT_CALLS=200
# LINKEDIN_DAILY_COMMENT_CALLS_PER_MEMBER=40
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# PINTEREST_SANDBOX=true
# GOOGLE_BUSINESS_CLIENT_ID=
# GOOGLE_BUSINESS_CLIENT_SECRET=
# PEAL_AI_PROVIDER=anthropic
# PEAL_AI_API_KEY=
# Images the assistant makes into the media library: off unless set, apart
# from the writing model. Any OpenAI-compatible server that serves
# /images/generations; the base URL and the model are required, the key
# optional. Each image costs 5 of a workspace's daily assistant requests.
# PEAL_AI_IMAGE_PROVIDER=openai-compatible
# PEAL_AI_IMAGE_BASE_URL=
# PEAL_AI_IMAGE_MODEL=
# PEAL_AI_IMAGE_API_KEY=

# Hosts on your own network that members may name, such as a website on a
# private address: host names or addresses, separated by commas. Peal
# reaches anything else members name at public addresses only, over HTTPS.
# List only hosts you trust every member with.
# PEAL_OUTBOUND_ALLOWED_HOSTS=

# Ads: off unless set. "read" lets workspaces connect Meta ad accounts and
# read their campaigns and numbers; "spend" also lets them boost published
# posts, which spends their money at Meta. Both need META_APP_ID and
# META_APP_SECRET above, on an app Meta gave ads access (the docs' "Ads"
# page, "What Meta asks of the operator"), and PEAL_TOKEN_KEYS. Stay on
# "read" until Meta granted the app ads_management.
# PEAL_ADS=read

# Comments on Facebook Pages, Instagram, YouTube and LinkedIn company
# pages in the inbox: off unless named (Mastodon and Bluesky are always
# read). "facebook" needs
# META_APP_ID and META_APP_SECRET above; "instagram" needs them or
# INSTAGRAM_APP_ID and INSTAGRAM_APP_SECRET; "youtube" needs
# YOUTUBE_CLIENT_ID and YOUTUBE_CLIENT_SECRET; "linkedin" needs
# LINKEDIN_PAGES_CLIENT_ID and LINKEDIN_PAGES_CLIENT_SECRET, and an app
# LinkedIn granted r_organization_social_feed and
# w_organization_social_feed, or every pages sign-in is refused. Add the
# comment permissions
# to the apps (the docs' "Self-hosting"): Meta grants them for accounts
# other than your app's own people's only after its App Review, and Google
# lets anyone but your test users grant youtube.force-ssl only once it
# verified your app. googleBusiness reads the reviews of Google Business
# Profile locations, with GOOGLE_BUSINESS_CLIENT_ID and its secret, once
# Google gave your project access to the Business Profile APIs (its quota
# is zero before).
# PEAL_INBOX_PLATFORMS=facebook,instagram,youtube,linkedin,googleBusiness

# The direct messages the inbox reads and answers: Mastodon's, and
# Bluesky's, whose sign-in then also asks for the chat scopes (channels
# connected before connect again to allow them). Messages are private
# correspondence: Peal keeps a conversation 30 days after its last message.
# Say so in your privacy policy before you turn them on.
# PEAL_INBOX_MESSAGES=mastodon,bluesky

# Partner accounts let a product of yours, or of the people on your Peal,
# use it for its own customers (the docs' "Embedding Peal"). Staff grant
# them from the staff console; uncomment to let every workspace's owners
# and admins open one themselves.
# PEAL_PARTNER_SELF_SERVICE=true

# Who may make an account: anyone unless set. With invitation, only from an
# invitation's link, with the address it went to, and the server's first
# account, which the sign-up page offers until it exists: make yours before
# the address is public (the docs' "Who may sign up").
# PEAL_SIGN_UP=invitation

# Members turn on two-step verification themselves, from their account
# settings, and owners may require it of a workspace: nothing to set. The
# authenticators' keys and recovery codes are encrypted with
# BETTER_AUTH_SECRET: replacing it without keeping the old one in
# BETTER_AUTH_SECRETS makes them unreadable. Uncomment to refuse the staff
# console to staff whose own account does not have it on, once each of
# them turned it on.
# PEAL_STAFF_TWO_STEP=true

# French law has a host keep what identifies whoever contributed content
# (loi n° 2004-575, art. 6, V). Uncomment if you are established in France,
# or offer your Peal there, and store content for other people; leave it
# off otherwise (the docs' self-hosting page, "Legal retention").
# PEAL_LEGAL_RETENTION=true

# What you declare about your processing, which each user's copy of their
# data repeats (GDPR Article 15): who you are, how to reach you, the
# providers you use and your supervisory authority. Copy
# self-host/privacy-declaration.example.json outside the repository, fill
# it in, and name it here; without it, the copy says none was declared.
# PEAL_PRIVACY_DECLARATION=/srv/peal/privacy-declaration.json

# Postgres's memory, each defaulting to PostgreSQL's own value (the docs'
# environment variables page says how to size them). Postgres restarts when
# one changes, and they replace any value set with ALTER SYSTEM or in
# postgresql.conf: move such a value here before upgrading. For example, where Postgres may have 16 GiB on solid-state
# disks:
# PEAL_POSTGRES_SHARED_BUFFERS=4GB
# PEAL_POSTGRES_EFFECTIVE_CACHE_SIZE=12GB
# PEAL_POSTGRES_MAINTENANCE_WORK_MEM=512MB
# PEAL_POSTGRES_RANDOM_PAGE_COST=1.1

# Optional backups with pgBackRest to an S3-compatible bucket: archives the
# write-ahead log continuously, then run
#   docker compose … exec --user postgres postgres pgbackrest stanza-create
#   docker compose … exec --user postgres postgres pgbackrest backup --type=full
# on a schedule. PGBACKREST_REPO1_CIPHER_PASS: openssl rand -hex 32.
# PEAL_POSTGRES_ARCHIVE_MODE=on
# The endpoint is a host, without https://; on R2 in the EU jurisdiction,
# <account>.eu.r2.cloudflarestorage.com.
# PGBACKREST_REPO1_S3_ENDPOINT=s3.example.com
# PGBACKREST_REPO1_S3_BUCKET=peal-backups
# PGBACKREST_REPO1_S3_REGION=auto
# PGBACKREST_REPO1_S3_KEY=
# PGBACKREST_REPO1_S3_KEY_SECRET=
# PGBACKREST_REPO1_CIPHER_PASS=

# Optional, on a server that bills (the docs' self-hosting page, "Billing"):
# where the web app sends people who need more than the largest plan
# allows, a page or a mailto: address. Unset, it tells them to write to
# whoever runs the server.
# PEAL_CONTACT_URL=mailto:sales@example.com
# And the day, as YYYY-MM-DD, until which a workspace on the free tier that
# holds more connected accounts than it includes, as every workspace made
# before billing was turned on may, still schedules and publishes; its
# billing managers are told. Unset or empty: no grace.
# PEAL_BILLING_GRACE_UNTIL=2027-01-31
# And the signing secret of the Stripe event destination that sends the
# meter error events (v1.billing.meter.error_report_triggered and
# v1.billing.meter.no_meter_found, thin events) to
# PUBLIC_URL/api/stripe/meter-errors. Unset or empty, that endpoint
# refuses every event, and a meter event Stripe could not count goes
# unheard.
# STRIPE_METER_WEBHOOK_SECRET=

# Optional: how many channels the hourly collection of post counts reads at
# once (16 by default). Raise it when the server logs that the collection
# could not finish before the next one.
# PEAL_ANALYTICS_CONCURRENCY=16

# Optional: read counts and followers on X. X bills your app for each post
# and each account a read returns (pay per use), so it is off unless set.
# Each workspace then reads X_ANALYTICS_DAILY_READS posts and accounts a
# UTC day at most (500 by default), one read again the same day not counted
# twice.
# X_ANALYTICS=true
# X_ANALYTICS_DAILY_READS=500

# Optional: whether a post's later parts go to X as a thread (true by
# default). X documents that an app on self-serve access may reply only
# under a post whose author mentioned or quoted the account; if X refuses
# your app the second part of a thread, set it to false, and X takes a post
# alone. To find out, send a post of two parts to an X account you own.
# X_THREADS=false

# Optional: how many custom thumbnails the server sets on YouTube videos a
# day, across every channel (80 by default). Each costs about 50 units of
# the Google project's general quota; past it, a video goes out with the
# thumbnail YouTube picks.
# YOUTUBE_DAILY_THUMBNAILS=80

# Optional: the units of that quota the inbox may spend reading YouTube
# comments a day (3000 by default), which with the thumbnails' 4,000
# leaves 3,000 for replies, lookups and analytics.
# YOUTUBE_DAILY_COMMENT_UNITS=3000

# Optional: how many channels the collection of comments, every ten
# minutes, reads at once (8 by default), and for how many days after a post
# went live its comments are read (30 by default, 90 at most). Comments are
# other people's personal data, kept 30 days past that window: a longer
# window keeps them longer.
# PEAL_ENGAGEMENT_CONCURRENCY=8
# PEAL_ENGAGEMENT_WINDOW_DAYS=30

# Optional: how many requests a minute each API key, and each application
# for each user it acts for, may send to the API and the MCP endpoint
# together (600 by default). Sessions of the web app are not counted.
# PEAL_API_REQUESTS_PER_MINUTE=600

# Optional: short links, off unless set. A post that asks goes out with
# its long links replaced by short addresses under this base, which count
# their clicks. Either on Peal's own host, which needs nothing more:
# PEAL_SHORT_LINK_BASE=https://peal.example.com/api/l/
# or on a domain of their own, with its block in self-host/Caddyfile
# uncommented:
# PEAL_SHORT_LINK_BASE=https://go.example.com/
# PEAL_SHORT_LINK_DOMAIN=go.example.com

# Optional: where your copy of the documentation is, if you serve one (as
# with PEAL_DOCS_DOMAIN above). The documents that tell programs where the
# API and the MCP endpoint are (/.well-known/api-catalog, /llms.txt) then
# link to its pages.
# PEAL_DOCS_URL=https://docs.example.com

# Optional: how many videos the server sends to platforms at once (one per
# GiB of memory by default, from 2 to 8). They are streamed, a part at a
# time; lower it on a server short of memory or bandwidth.
# PEAL_MAX_CONCURRENT_UPLOADS=2

# Optional: the share of traces the server exports to the stack's Tempo. It
# keeps one in ten by default, and always the attempts to publish, the
# requests it fails and the slow spans. On a small server, keep them all.
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=0.1

# Optional alerts: Grafana's rules notify the Telegram chat TELEGRAM_CHAT_ID
# through the bot TELEGRAM_BOT_TOKEN, and its heartbeat tells an outside
# checker, every 5 minutes or so, that they still can. The checker gives the
# URL and the bearer token, such as a Gatus external endpoint's
# https://status.example.com/api/v1/endpoints/<group>_<name>/external?success=true.
# PEAL_GRAFANA_CONTACT_POINTS=./config/production/grafana/alerting/telegram.yaml
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# telegram-slack.yaml sends the same alerts to a Slack channel too, through
# an incoming webhook, naming the environment in each message.
# PEAL_GRAFANA_CONTACT_POINTS=./config/production/grafana/alerting/telegram-slack.yaml
# SLACK_ALERTS_WEBHOOK_URL=
# PEAL_GRAFANA_ENVIRONMENT=production
# PEAL_GRAFANA_HEARTBEAT=./config/production/grafana/alerting/heartbeat.yaml
# PEAL_HEARTBEAT_URL=
# PEAL_HEARTBEAT_TOKEN=
