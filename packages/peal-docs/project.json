{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "peal-docs",
  "projectType": "application",
  "implicitDependencies": ["peal-contract"],
  "targets": {
    "typecheck": {
      "command": "tsc --noEmit && blume check --strict --isolated",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["peal-contract:openapi"]
    },
    "validate": {
      "command": "blume validate --strict",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["peal-contract:openapi"],
      "cache": false
    },
    "typography": {
      "command": "bun scripts/french-typography.ts --check",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["validate", "typography"]
    },
    "build": {
      "command": "blume build",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["...", "peal-contract:openapi"],
      "inputs": [
        "...",
        { "env": "DOCS_SITE_URL" },
        { "env": "DOCS_APP_URL" },
        { "env": "DOCS_ASSISTANT_MODEL" },
        { "env": "DOCS_TURNSTILE_SITE_KEY" },
        { "env": "DOCS_POSTHOG_KEY" },
        { "env": "DOCS_POSTHOG_HOST" },
        { "env": "DOCS_POSTHOG_COOKIE_DOMAIN" },
        { "env": "DOCS_POSTHOG_ENVIRONMENT" },
        { "env": "DOCS_PRIVACY_URL" },
        { "env": "DOCS_CRISP_WEBSITE_ID" }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "dev": {
      "command": "blume dev --port 4322",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["peal-contract:openapi"],
      "continuous": true
    }
  }
}
