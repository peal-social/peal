---
// Blume's own sidebar, then a button that opens the web app, held at the
// foot of the sidebar as the app holds its workspace switcher (DESIGN.md,
// "The frame"). The app's address comes from DOCS_APP_URL when the docs are
// built; unset, there is no button, as a self-hosted copy may have no app
// to point at.
import NavTree from "blume/components/layout/NavTree.astro";
import Icon from "blume/components/Icon.astro";

const appUrl = process.env.DOCS_APP_URL?.trim().replace(/\/+$/u, "");
const french = Astro.url.pathname === "/fr" || Astro.url.pathname.startsWith("/fr/");
const label = french ? "Tableau de bord" : "Dashboard";
const href = appUrl === undefined || appUrl === "" ? undefined : `${appUrl}${french ? "/fr" : ""}`;
---

<NavTree {...Astro.props} />
{
  href !== undefined && (
    <div class="peal-app-link">
      <a href={href} data-measure-cta="dashboard" data-measure-place="sidebar">
        <Icon name="layout-dashboard" size={16} />
        <span>{label}</span>
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
  )
}

<script>
  // A reader who picks a language in one code sample sees it first in every
  // sample after, on this page and the next ones. Blume already syncs the
  // tabs of one page; this keeps the choice in the browser across pages.
  // Only the SDK languages and curl are remembered: "CLI" is also a tab of
  // the guides' "Web app / CLI" groups, which should open on the app.
  const STORAGE_KEY = "peal-docs-code-language";
  const LANGUAGES = new Set(["Node.js", "Python", "Go", "Ruby", "Java", "PHP", ".NET", "Rust", "curl"]);

  type BlumeTabs = HTMLElement & { activateByTitle: (title: string, sync: boolean) => void };

  const read = (): string | undefined => {
    try {
      return localStorage.getItem(STORAGE_KEY) ?? undefined;
    } catch {
      return undefined;
    }
  };

  document.addEventListener("blume-tabs-change", (event) => {
    // SAFETY: Blume's tabs (blume/components/content/Tabs.astro) dispatch
    // this event only as a CustomEvent whose detail is { key?, title? }.
    const { detail } = event as CustomEvent<{ key?: string; title?: string }>;

    if (detail?.title === undefined || !LANGUAGES.has(detail.title) || (detail.key ?? "") !== "") {
      return;
    }

    try {
      localStorage.setItem(STORAGE_KEY, detail.title);
    } catch {
      // Storage refused (private window): the choice lasts for this page only.
    }
  });

  // Switches every group that has a tab with this title, and answers how many.
  const activate = (title: string): number => {
    const groups = [...document.querySelectorAll<BlumeTabs>("blume-tabs")].filter((tabs) =>
      [...tabs.querySelectorAll('[role="tab"]')].some((tab) => tab.textContent?.trim() === title)
    );

    for (const tabs of groups) {
      tabs.activateByTitle(title, false);
    }

    return groups.length;
  };

  const restore = () => {
    const title = read();

    if (title === undefined || !LANGUAGES.has(title)) {
      return;
    }

    customElements
      .whenDefined("blume-tabs")
      .then(() => activate(title))
      .catch(() => {
        // The tabs never loaded: there is nothing to switch.
      });
  };

  document.addEventListener("astro:page-load", restore);

  restore();
</script>

<style>
  /* Stays at the foot of the sidebar while its list scrolls. */
  .peal-app-link {
    position: sticky;
    /* Down to the sidebar's edge, over its bottom padding, so nothing of
       the list shows below the button. */
    bottom: -1.5rem;
    z-index: 1;
    margin-top: 1.5rem;
    margin-bottom: -1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 1.5rem;
    background: var(--blume-background);
  }

  /* The ink button DESIGN.md gives a page's main action: 34 px high, 6 px
     radius, the background's colour on the foreground's. */
  .peal-app-link a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 34px;
    padding: 0 0.75rem;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .peal-app-link a span {
    flex: 1;
  }

  .peal-app-link a:hover {
    background: color-mix(in srgb, var(--primary) 88%, white);
  }

  .peal-app-link a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
</style>
