---
import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { SiteFooter } from "peal-ui/components/site-footer";
import { SiteHeader } from "peal-ui/components/site-header";

import { chrome } from "../components/chrome.ts";
import { plausible } from "../config.ts";
import type { PageLinks } from "../navigation.ts";
import { defaultLocale, locales, pageLocale } from "../i18n/locales.ts";
import "../styles/global.css";

interface Props {
  /** Which of the header's own pages this is, to mark it current. */
  readonly current?: PageLinks["current"];
  readonly description: string;
  /** Keep the page out of search engines, as drafts are. */
  readonly noindex?: boolean;
  /** The page's path below its locale prefix: "" for the home page. */
  readonly path: string;
  readonly title: string;
}

const { current, description, noindex = false, path, title } = Astro.props;

const locale = pageLocale(Astro.currentLocale);

const { footer, header } = await chrome(locale, path, current);

// Canonical and alternate links need absolute URLs, so they are only emitted
// when SITE_URL gives the site its origin.
const absolute = (code: string): string | undefined =>
  Astro.site === undefined
    ? undefined
    : new URL(getRelativeLocaleUrl(code, path), Astro.site).href;

const canonical = absolute(locale);

const alternates = locales.map((code) => ({ code, href: absolute(code) }));

const fallback = absolute(defaultLocale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical !== undefined && <link rel="canonical" href={canonical} />}
    {
      alternates.map(
        ({ code, href }) =>
          href !== undefined && (
            <link rel="alternate" hreflang={code} href={href} />
          )
      )
    }
    {
      fallback !== undefined && (
        <link rel="alternate" hreflang="x-default" href={fallback} />
      )
    }
    {
      plausible !== undefined && (
        <script
          is:inline
          defer
          data-domain={plausible.domain}
          src={plausible.src}
        ></script>
      )
    }
    <slot name="head" />
  </head>
  <body class="relative flex min-h-dvh flex-col antialiased">
    <!-- The blueprint's rails (DESIGN.md, Site): the content column's edges,
         from the header to the footer, under everything that has a fill. -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 left-1/2 w-full max-w-6xl -translate-x-1/2 border-x"
    >
    </div>
    <SiteHeader client:load {...header} />
    <main class="relative flex-1">
      <slot />
    </main>
    <!-- Hydrated for its language menu once the page is idle, well before a
         reader scrolls down to it (on view, a first click could come
         before the menu listens). -->
    <SiteFooter client:idle {...footer} />
  </body>
</html>
