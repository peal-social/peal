---
import type { GetStaticPaths } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { AccountPricer } from "peal-ui/components/account-pricer";
import { buttonVariants } from "peal-ui/components/button";
import { CtaBand } from "peal-ui/components/cta-band";
import { PixelGlow } from "peal-ui/components/pixel-glow";
import { RateCard } from "peal-ui/components/rate-card";
import { Eyebrow } from "peal-ui/components/section-opener";

import { appLink, docsLink } from "../../config.ts";
import { ctaLinks } from "../../home.ts";
import { localePaths, pageLocale } from "../../i18n/locales.ts";
import { messages } from "../../i18n/messages.ts";
import Base from "../../layouts/base.astro";
import { pricingPage } from "../../pricing.ts";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const locale = pageLocale(Astro.currentLocale);

const catalogue = messages(locale);

const t = catalogue.pricing;

const page = pricingPage(locale, t);

const signUp = appLink(locale, "sign-up");

const cta =
  signUp === undefined
    ? undefined
    : { href: signUp, label: catalogue.home.hero.primary };

const selfHosting = docsLink(locale, "self-hosting");

// The closing band, as the home page's.
const closing = ctaLinks(catalogue.home.cta, {
  app: (path) => appLink(locale, path),
  docs: (path) => docsLink(locale, path),
});

const [cloudPlan, enterprisePlan] = page.rateCard.plans;

// The rate card's plans, with the build's ways in.
const plans = [
  ...(cloudPlan === undefined
    ? []
    : [{ ...cloudPlan, action: cta === undefined ? undefined : { ...cta, primary: true } }]),
  ...(enterprisePlan === undefined
    ? []
    : [
        {
          ...enterprisePlan,
          action: { href: page.enterprise.href, label: page.enterprise.talk },
        },
      ]),
];

---

<Base
  current="pricing"
  description={t.description}
  path="pricing"
  title={`${t.title} · Peal`}
>
  <div class="relative isolate mx-auto max-w-6xl overflow-hidden">
    <PixelGlow client:load />
    <section
      aria-labelledby="pricing-title"
      class="mx-auto flex max-w-3xl flex-col items-center gap-5 px-6 pt-20 pb-16 text-center sm:pt-24"
    >
      <Eyebrow icon="scale" label={t.title} />
      <h1
        id="pricing-title"
        class="text-4xl leading-[1.05] font-semibold tracking-[-0.025em] sm:text-[56px]"
      >
        {page.headline.text}{" "}
        <span class="text-muted-foreground">{page.headline.muted}</span>
      </h1>
      <p class="text-muted-foreground max-w-[40rem] text-base sm:text-lg">
        {page.lead}
      </p>
    </section>
  </div>

  <section
    aria-label={t.calculator.label}
    class="mx-auto max-w-6xl border-y"
  >
    <AccountPricer client:visible {...page.calculator} cta={cta}>
      <div
        class="flex flex-col gap-6 border-b p-6 sm:p-8 lg:row-span-4 lg:grid lg:grid-rows-subgrid lg:border-e lg:border-b-0"
      >
        <div>
          <h3 class="text-[15px] font-semibold">{page.enterprise.title}</h3>
          <p class="text-muted-foreground mt-1 text-sm">
            {page.enterprise.line}
          </p>
        </div>
        <p
          class="text-[40px] leading-none font-semibold tracking-[-0.025em]"
        >
          {page.enterprise.price}
        </p>
        <a
          href={page.enterprise.href}
          data-measure-cta="talk_to_sales"
          data-measure-place="pricing"
          class={buttonVariants({ className: "w-fit", variant: "outline" })}
        >
          {page.enterprise.talk}
        </a>
        <ul
          class="text-muted-foreground flex flex-col gap-1.5 border-t pt-5 text-sm"
        >
          {
            page.enterprise.items.map((item) => (
              <li class="flex gap-2">
                <span
                  aria-hidden="true"
                  class="bg-brand mt-[7px] size-[5px] shrink-0"
                />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div
        class="flex flex-col gap-6 p-6 sm:p-8 lg:row-span-4 lg:grid lg:grid-rows-subgrid"
      >
        <div>
          <h3 class="text-[15px] font-semibold">{t.selfHosted.title}</h3>
          <p class="text-muted-foreground mt-1 text-sm">{t.selfHost}</p>
        </div>
        <p
          class="text-[40px] leading-none font-semibold tracking-[-0.025em]"
        >
          {t.selfHosted.price}
        </p>
        {
          selfHosting === undefined ? (
            <span />
          ) : (
            <a
              href={selfHosting}
              data-measure-cta="self_host"
              data-measure-place="pricing"
              class={buttonVariants({ className: "w-fit", variant: "outline" })}
            >
              {t.selfHosted.link}
            </a>
          )
        }
        <ul
          class="text-muted-foreground flex flex-col gap-1.5 border-t pt-5 text-sm"
        >
          {
            t.selfHosted.items.map((item) => (
              <li class="flex gap-2">
                <span
                  aria-hidden="true"
                  class="bg-brand mt-[7px] size-[5px] shrink-0"
                />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </AccountPricer>
  </section>

  <section
    aria-labelledby="pricing-features"
    class="mx-auto max-w-6xl pt-16 pb-24"
  >
    <div class="border-y">
      <RateCard
        client:visible
        eyebrow={{ icon: "layers", label: page.rateCard.eyebrow }}
        groups={page.rateCard.groups}
        headingId="pricing-features"
        note={{
          link: {
            href: getRelativeLocaleUrl(locale, "terms"),
            label: t.legal.terms,
          },
          text: page.vat,
        }}
        plans={plans}
        rows={page.rateCard.rows}
        title={page.rateCard.title}
      />
    </div>
  </section>

  <CtaBand
    client:visible
    line={catalogue.home.cta.line}
    primary={closing.primary}
    secondary={{
      href: page.enterprise.href,
      label: page.enterprise.talk,
      measure: "talk_to_sales",
    }}
    title={catalogue.home.cta.title}
  />
</Base>

