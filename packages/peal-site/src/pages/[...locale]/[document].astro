---
import type { GetStaticPaths } from "astro";
import { getEntry, render } from "astro:content";

import { pageLocale } from "../../i18n/locales.ts";
import { messages } from "../../i18n/messages.ts";
import Base from "../../layouts/base.astro";
import { legalDates } from "../../legal-page.ts";
import { legalLayout } from "../../legal-sections.ts";
import { legalDocument, legalPaths } from "../../legal.ts";

// A legal document: one column under its title and dates, its numbered
// contents, then its sections.

export const getStaticPaths = (() => legalPaths()) satisfies GetStaticPaths;

const { document: parameter } = Astro.params;

const document = legalDocument(parameter);

const locale = pageLocale(Astro.currentLocale);

const entry =
  document === undefined
    ? undefined
    : await getEntry("legal", `${locale}/${document}`);

if (document === undefined || entry === undefined) {
  throw new Error(
    `No legal document at src/content/legal/${locale}/${parameter ?? ""}.md: each one needs a version in every locale.`
  );
}

const { headings } = await render(entry);

const { preamble, sections } = legalLayout(entry.rendered?.html ?? "");

// The contents list the numbered sections: every `##` but the opening
// summary, which takes no number.
const numbered = headings.filter(({ depth }) => depth === 2);

const [first, ...others] = sections;

// The opening summary comes before the contents, the numbered sections
// after them.
const opening = first?.kind === "opening" ? first : undefined;

const numberedSections = opening === undefined ? sections : others;

const contents = opening === undefined ? numbered : numbered.slice(1);

const t = messages(locale);

const dates = legalDates(t.legalPage, locale, entry.data);
---

<Base
  description={entry.data.description}
  noindex={entry.data.draft}
  path={document}
  title={`${entry.data.title} · ${t.nav.brand}`}
>
  <article class="mx-auto max-w-6xl px-4 py-16 sm:px-8 sm:py-24">
    <div class="mx-auto max-w-[44rem]">
      {
        entry.data.draft && (
          <aside
            role="note"
            class="mb-10 rounded-lg border border-amber-300 bg-amber-50 p-5 text-amber-950"
          >
            <p class="font-semibold">{t.draft.title}</p>
            <p class="mt-1 text-sm">{t.draft.body}</p>
          </aside>
        )
      }
      <h1
        class="text-4xl leading-[1.05] font-semibold tracking-[-0.025em] sm:text-[56px]"
      >
        {entry.data.title}
      </h1>
      {
        dates.length > 0 && (
          <p class="text-muted-foreground mt-6 flex flex-col gap-1 font-mono text-xs tabular-nums">
            {dates.map((line) => (
              <span>{line}</span>
            ))}
          </p>
        )
      }
      <div class="legal prose prose-neutral prose-table:text-sm">
        <Fragment set:html={preamble} />
        {
          opening !== undefined && (
            <section class="legal-section legal-opening">
              <Fragment set:html={opening.text} />
            </section>
          )
        }
        {
          contents.length > 3 && (
            <nav aria-label={t.legalPage.contents} class="legal-contents not-prose">
              <ol>
                {contents.map(({ slug, text }) => (
                  <li>
                    <a href={`#${slug}`}>{text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          numberedSections.map(({ aside, kind, text }) => (
            <section class={`legal-section legal-${kind}`}>
              <Fragment set:html={text} />
              {aside !== undefined && <Fragment set:html={aside} />}
            </section>
          ))
        }
      </div>
    </div>
  </article>
</Base>
