---
import type { GetStaticPaths } from "astro";
import { ProductPair } from "peal-ui/components/app-mock";
import { buttonVariants } from "peal-ui/components/button";
import { ConnectMenu } from "peal-ui/components/connect-menu";
import { CtaBand } from "peal-ui/components/cta-band";
import { FaqSection } from "peal-ui/components/faq-section";
import { FeatureGrid } from "peal-ui/components/feature-cell";
import { HeroStage } from "peal-ui/components/hero-stage";
import { PixelGlow } from "peal-ui/components/pixel-glow";
import { ProductBento } from "peal-ui/components/product-bento";
import { ProductIntro } from "peal-ui/components/product-intro";
import { ProductRows } from "peal-ui/components/product-rows";
import { SectionOpener } from "peal-ui/components/section-opener";
import { formatStars } from "peal-ui/lib/site/stars";

import { skillDocument, skillsRoot } from "../../agent-skills.ts";
import { homeCode } from "../../code/home-code.ts";
import CodeBlock from "../../components/code-block.astro";
import { appLink, docsLink } from "../../config.ts";
import { faqGroups, faqJsonLdText } from "../../faq.ts";
import { latestPulls, repositoryStars } from "../../github.ts";
import {
  apiCode,
  apiRows,
  connectMenu,
  ctaLinks,
  glowParts,
  hardPartCells,
  heroCode,
  heroTabs,
  openCells,
  productPair,
  sectionAction,
  studioBento,
  withPlatformCount,
} from "../../home.ts";
import type { HomeSettings } from "../../home.ts";
import { localePaths, pageLocale } from "../../i18n/locales.ts";
import { messages } from "../../i18n/messages.ts";
import Base from "../../layouts/base.astro";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const locale = pageLocale(Astro.currentLocale);

const catalogue = messages(locale);

const t = catalogue.home;

const stars = await repositoryStars();

// Highlighted here, at build time: the page ships runs of text, no highlighter.
const code = await homeCode();

const settings: HomeSettings = {
  app: (page) => appLink(locale, page),
  docs: (page) => docsLink(locale, page),
  pulls: await latestPulls(),
  stars: stars === undefined ? undefined : formatStars(stars, locale),
};

// Every section below the hero carries its number, as `[ 01 / 06 ] · Products`.
const sections = [
  t.sections.platforms,
  t.sections.studio,
  t.sections.api,
  t.sections.open,
  t.sections.hardParts,
  t.sections.faq,
];

const pad = (value: number) => String(value).padStart(2, "0");

const counter = (index: number) =>
  `[ ${pad(index + 1)} / ${pad(sections.length)} ] · ${sections[index] ?? ""}`;

const faq = faqGroups(locale);

// The hero's second button is the Connect menu, not the docs.
const hero = ctaLinks({ primary: t.hero.primary }, settings);

// The prompt points at the skill this site serves, by its full address.
const skill =
  Astro.site === undefined
    ? undefined
    : new URL(`${skillsRoot}/peal/${skillDocument}`, Astro.site).href;

const connect = connectMenu(t.hero.connect, settings, skill);

const cta = ctaLinks(t.cta, settings);

const pair = productPair(t);

const bento = studioBento(locale, t, settings);
---

<Base
  description={withPlatformCount(t.description)}
  path=""
  title={t.title}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={faqJsonLdText(faq)}
  />
  <div class="mx-auto max-w-6xl">
    <section
      aria-labelledby="hero-title"
      class="flex flex-col gap-12 pb-24"
    >
      <!-- The words on the centre line, in a band like the closing one: its
      glow around them, a rule under it. -->
      <div
        class="relative isolate overflow-hidden border-b px-4 pt-20 pb-20 sm:px-6 sm:pt-24 sm:pb-24 lg:px-10"
      >
        <PixelGlow client:load layout="band" />
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <h1
            id="hero-title"
            class="text-4xl leading-[1.05] font-semibold tracking-[-0.025em] text-balance sm:text-[56px]"
          >
            {`${t.hero.title.first} `}<br class="hidden sm:inline" />{
              t.hero.title.second
            }
          </h1>
          <p
            class="text-foreground mt-6 max-w-[40rem] text-base font-medium text-balance sm:text-lg"
          >
            {
              glowParts(t.hero.lead).map((part) =>
                part.glow ? (
                  <span class="text-shimmer-brand">{part.text}</span>
                ) : (
                  part.text
                )
              )
            }
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            {
              hero.primary === undefined ? null : (
                <a
                  href={hero.primary.href}
                  data-measure-cta="get_started"
                  data-measure-place="hero"
                  class={buttonVariants({ className: "border-shimmer" })}
                >
                  {hero.primary.label}
                </a>
              )
            }
            {
              connect === undefined ? null : (
                <ConnectMenu client:load place="hero" {...connect} />
              )
            }
          </div>
        </div>
      </div>
      <div class="px-4 sm:px-6 lg:px-10">
        <HeroStage
          client:load
          className="border"
          label={t.hero.stage}
          tabs={heroTabs(locale, catalogue, settings)}
        >
          <CodeBlock
            slot="code"
            block={heroCode(t, code)}
            class="rounded-none border-0"
          />
        </HeroStage>
      </div>
    </section>
  </div>

  <section id="products" aria-labelledby="products-title" class="scroll-mt-8">
    <SectionOpener
      client:visible
      counter={counter(0)}
      eyebrow={{ icon: "layers", label: t.platforms.eyebrow }}
      headingId="products-title"
      title={t.platforms.title}
    />
    <ProductPair mocks={pair.mocks} products={pair.products} />
  </section>

  <section id="studio" aria-labelledby="studio-title" class="scroll-mt-8">
    <ProductIntro
      client:visible
      action={sectionAction(settings, "guides", t.studio.action)}
      counter={counter(1)}
      eyebrow={{ icon: "pen", label: t.studio.eyebrow }}
      headingId="studio-title"
      lead={t.studio.lead}
      title={t.studio.title}
    />
    <ProductBento client:visible cards={bento.cards} tiles={bento.tiles} />
  </section>

  <section id="api" aria-labelledby="api-title" class="scroll-mt-8">
    <ProductIntro
      client:visible
      action={sectionAction(settings, "developers", t.api.action)}
      counter={counter(2)}
      eyebrow={{ icon: "braces", label: t.api.eyebrow }}
      headingId="api-title"
      lead={t.api.lead}
      title={t.api.title}
    />
    <!-- Static: only the code blocks in it hydrate, each on view. -->
    <ProductRows rows={apiRows(t, settings)}>
      {
        Object.entries(apiCode(t, code)).map(([slot, block]) => (
          <CodeBlock slot={slot} block={block} />
        ))
      }
    </ProductRows>
  </section>

  <section id="open" aria-labelledby="open-title" class="scroll-mt-8">
    <SectionOpener
      client:visible
      counter={counter(3)}
      eyebrow={{ icon: "pull-request", label: t.open.eyebrow }}
      headingId="open-title"
      lead={t.open.lead}
      title={t.open.title}
    />
    <FeatureGrid cells={openCells(locale, t, settings)} />
  </section>

  <section id="hard-parts" aria-labelledby="hard-parts-title" class="scroll-mt-8">
    <SectionOpener
      client:visible
      counter={counter(4)}
      eyebrow={{ icon: "shield", label: t.hardParts.eyebrow }}
      headingId="hard-parts-title"
      lead={t.hardParts.lead}
      title={t.hardParts.title}
    />
    <FeatureGrid cells={hardPartCells(locale, t)} />
  </section>

  <FaqSection
    client:visible
    className="pt-0 pb-24"
    counter={counter(5)}
    groups={faq}
    label={t.faq.label}
    title={t.faq.title}
  />

  <CtaBand
    client:visible
    line={t.cta.line}
    primary={cta.primary}
    secondary={cta.secondary}
    title={t.cta.title}
  />
</Base>
