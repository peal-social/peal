---
import type { GetStaticPaths } from "astro";
import { AsciiArt } from "peal-ui/components/ascii-art";
import { BrandField } from "peal-ui/components/brand-field";
import { CodeDemo } from "peal-ui/components/code-demo";
import { CtaBand } from "peal-ui/components/cta-band";
import { FaqSection } from "peal-ui/components/faq-section";
import { FeatureGrid } from "peal-ui/components/feature-cell";
import { SectionOpener } from "peal-ui/components/section-opener";
import { TileGrid } from "peal-ui/components/tile-grid";
import { UseCases } from "peal-ui/components/use-cases";

import { appLink, docsLink } from "../../config.ts";
import { faqGroups, faqJsonLdText } from "../../faq.ts";
import { formatStars, latestPulls, repositoryStars } from "../../github.ts";
import { demoTabs } from "../../home-demo.ts";
import {
  agentTiles,
  ctaLinks,
  hardPartCells,
  openCells,
  useCases,
} from "../../home.ts";
import type { HomeSettings } from "../../home.ts";
import { localePaths, pageLocale } from "../../i18n/locales.ts";
import { messages } from "../../i18n/messages.ts";
import Base from "../../layouts/base.astro";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const locale = pageLocale(Astro.currentLocale);

const catalogue = messages(locale);

const t = catalogue.home;

const stars = await repositoryStars();

const settings: HomeSettings = {
  app: (page) => appLink(locale, page),
  docs: (page) => docsLink(locale, page),
  pulls: await latestPulls(),
  stars: stars === undefined ? undefined : formatStars(stars, locale),
};

// Every section below the hero carries its number, as `[ 01 / 06 ] · Try it`.
const sections = [
  t.sections.tryIt,
  t.sections.agents,
  t.sections.open,
  t.sections.hardParts,
  t.sections.useCases,
  t.sections.faq,
];

const pad = (value: number) => String(value).padStart(2, "0");

const counter = (index: number) =>
  `[ ${pad(index + 1)} / ${pad(sections.length)} ] · ${sections[index] ?? ""}`;

const faq = faqGroups(locale);

const cta = ctaLinks(t, settings);
---

<Base description={t.description} path="" title={t.title}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={faqJsonLdText(faq)}
  />
  <BrandField
    captions={catalogue.footer.captions}
    railsClassName="inset-x-[max(0px,calc((100%-72rem)/2))] top-8 bottom-12"
  >
    <section
      class="mx-auto grid max-w-6xl items-center gap-10 px-6 pt-20 pb-24 sm:pt-24 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:px-10"
    >
      <div>
        <p class="font-mono text-xs tracking-[0.04em] lowercase">
          {t.hero.status}
        </p>
        <h1
          class="mt-6 max-w-2xl text-4xl leading-[1.05] font-semibold tracking-[-0.025em] sm:text-[56px]"
        >
          {t.hero.title}
        </h1>
        <p class="mt-6 max-w-[40rem] text-base sm:text-lg">
          {t.hero.lead}
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href="#try-it"
            class="bg-card text-foreground hover:bg-muted focus-visible:ring-ring/50 inline-flex h-8 items-center rounded-md px-3 text-sm font-medium outline-none focus-visible:ring-3"
          >
            {t.hero.primary}
          </a>
          <a
            href="#open"
            class="focus-visible:ring-ring/50 inline-flex h-8 items-center rounded-md px-3 text-sm font-medium underline-offset-4 outline-none hover:underline focus-visible:ring-3"
          >
            {t.hero.secondary}
          </a>
        </div>
      </div>
      <div class="bg-background overflow-hidden rounded-md">
        <AsciiArt client:visible className="h-80 sm:h-96" variant="pixels" />
      </div>
    </section>
  </BrandField>

  <section id="try-it" aria-labelledby="try-it-title" class="scroll-mt-8">
    <SectionOpener
      client:visible
      counter={counter(0)}
      eyebrow={{ icon: "code", label: t.tryIt.eyebrow }}
      headingId="try-it-title"
      lead={t.tryIt.lead}
      title={t.tryIt.title}
    />
    <CodeDemo
      client:visible
      copied={t.tryIt.copied}
      copy={t.tryIt.copy}
      label={t.tryIt.label}
      tabs={demoTabs}
    />
  </section>

  <section id="agents" aria-labelledby="agents-title" class="scroll-mt-8">
    <SectionOpener
      client:visible
      counter={counter(1)}
      eyebrow={{ icon: "bot", label: t.agents.eyebrow }}
      headingId="agents-title"
      lead={t.agents.lead}
      title={t.agents.title}
    />
    <TileGrid groups={agentTiles(t, settings)} />
  </section>

  <section id="open" aria-labelledby="open-title" class="scroll-mt-8">
    <SectionOpener
      client:visible
      counter={counter(2)}
      eyebrow={{ icon: "pull-request", label: t.open.eyebrow }}
      headingId="open-title"
      lead={t.open.lead}
      title={t.open.title}
    />
    <FeatureGrid cells={openCells(locale, t, settings)} />
  </section>

  <section id="hard-parts" aria-labelledby="hard-parts-title" class="scroll-mt-8">
    <SectionOpener
      client:visible
      counter={counter(3)}
      eyebrow={{ icon: "shield", label: t.hardParts.eyebrow }}
      headingId="hard-parts-title"
      lead={t.hardParts.lead}
      title={t.hardParts.title}
    />
    <FeatureGrid cells={hardPartCells(locale, t)} />
  </section>

  <section id="use-cases" aria-labelledby="use-cases-title" class="scroll-mt-8">
    <SectionOpener
      client:visible
      counter={counter(4)}
      eyebrow={{ icon: "users", label: t.useCases.eyebrow }}
      headingId="use-cases-title"
      lead={t.useCases.lead}
      title={t.useCases.title}
    />
    <UseCases
      client:visible
      cases={useCases(t, settings)}
      label={t.useCases.label}
    />
  </section>

  <FaqSection
    client:visible
    className="pt-0 pb-24"
    counter={counter(5)}
    groups={faq}
    label={t.faq.label}
    lead={t.faq.lead}
    title={t.faq.title}
  />

  <CtaBand
    captions={catalogue.footer.captions}
    line={t.cta.line}
    primary={cta.primary}
    secondary={cta.secondary}
    title={t.cta.title}
  />
</Base>
