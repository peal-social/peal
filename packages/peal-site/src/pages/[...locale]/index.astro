---
import type { GetStaticPaths } from "astro";
import { AsciiArt } from "peal-ui/components/ascii-art";
import { BrandField } from "peal-ui/components/brand-field";

import { Features } from "../../components/features.tsx";
import { docsLink } from "../../config.ts";
import { localePaths, pageLocale } from "../../i18n/locales.ts";
import { messages } from "../../i18n/messages.ts";
import Base from "../../layouts/base.astro";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const locale = pageLocale(Astro.currentLocale);

const catalogue = messages(locale);

const t = catalogue.home;

const selfHostingGuide = docsLink(locale, "self-hosting");
---

<Base description={t.description} path="" title={t.title}>
  <BrandField
    captions={catalogue.footer.captions}
    railsClassName="inset-x-[max(0px,calc((100%-72rem)/2))] top-8 bottom-12"
  >
    <section
      class="mx-auto grid max-w-6xl items-center gap-10 px-6 pt-20 pb-24 sm:pt-24 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:px-10"
    >
      <div>
        <p class="font-mono text-xs tracking-[0.04em] lowercase">
          {t.hero.status}
        </p>
        <h1
          class="mt-6 max-w-2xl text-4xl leading-[1.05] font-semibold tracking-[-0.025em] sm:text-[56px]"
        >
          {t.hero.title}
        </h1>
        <p class="mt-6 max-w-[40rem] text-base sm:text-lg">
          {t.hero.lead}
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href="#features"
            class="bg-card text-foreground hover:bg-muted focus-visible:ring-ring/50 inline-flex h-8 items-center rounded-md px-3 text-sm font-medium outline-none focus-visible:ring-3"
          >
            {t.hero.primary}
          </a>
          <a
            href="#self-host"
            class="focus-visible:ring-ring/50 inline-flex h-8 items-center rounded-md px-3 text-sm font-medium underline-offset-4 outline-none hover:underline focus-visible:ring-3"
          >
            {t.hero.secondary}
          </a>
        </div>
      </div>
      <div class="bg-background overflow-hidden rounded-md">
        <AsciiArt client:visible className="h-80 sm:h-96" />
      </div>
    </section>
  </BrandField>

  <section
    id="features"
    aria-labelledby="features-title"
    class="mx-auto max-w-6xl scroll-mt-8 pt-16"
  >
    <h2
      id="features-title"
      class="px-6 text-[30px] leading-[1.1] font-semibold tracking-[-0.025em] sm:text-[40px]"
    >
      {t.featuresTitle}
    </h2>
    <div class="mt-10">
      <Features features={t.features} />
    </div>
    <div class="border-b p-6" role="note">
      <h3 class="text-[15px] font-semibold">{t.unconfirmed.title}</h3>
      <p class="text-muted-foreground mt-2 text-sm">
        {t.unconfirmed.body}
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl sm:grid-cols-2">
    <div id="self-host" class="scroll-mt-8 border-b p-6 py-12 sm:border-e">
      <h2 class="text-2xl font-semibold tracking-[-0.025em]">
        {t.selfHost.title}
      </h2>
      <p class="text-muted-foreground mt-4 text-sm">
        {t.selfHost.body}
      </p>
      {
        selfHostingGuide !== undefined && (
          <p class="mt-4 text-sm">
            <a
              href={selfHostingGuide}
              class="text-brand-text font-medium underline underline-offset-4"
            >
              {t.selfHost.docs}
            </a>
          </p>
        )
      }
    </div>
    <div class="border-b p-6 py-12">
      <h2 class="text-2xl font-semibold tracking-[-0.025em]">
        {t.fairSource.title}
      </h2>
      <p class="text-muted-foreground mt-4 text-sm">
        {t.fairSource.body}
      </p>
    </div>
  </section>
</Base>
