{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "peal-site",
  "projectType": "application",
  "implicitDependencies": ["peal-skills"],
  "targets": {
    "typegen": {
      "command": "astro sync",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["typegen"]
    },
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "command": "astro build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "...",
        {
          "env": "SITE_URL"
        },
        {
          "env": "SITE_APP_URL"
        },
        {
          "env": "SITE_DOCS_URL"
        },
        {
          "env": "SITE_DISCORD_URL"
        },
        {
          "env": "SITE_CRISP_WEBSITE_ID"
        },
        {
          "env": "SITE_POSTHOG_KEY"
        },
        {
          "env": "SITE_POSTHOG_HOST"
        },
        {
          "env": "SITE_POSTHOG_COOKIE_DOMAIN"
        },
        {
          "env": "SITE_POSTHOG_ENVIRONMENT"
        }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "build-e2e": {
      "command": "astro build --outDir dist-e2e",
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "SITE_APP_URL": "",
          "SITE_POSTHOG_ENVIRONMENT": "e2e",
          "SITE_POSTHOG_HOST": "/pulse/site",
          "SITE_POSTHOG_KEY": "phc_synthetic"
        }
      },
      "inputs": ["..."],
      "outputs": ["{projectRoot}/dist-e2e"]
    },
    "dev": {
      "command": "astro dev --port 4321",
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "ASTRO_DEV_BACKGROUND": "0"
        }
      },
      "continuous": true
    }
  }
}
