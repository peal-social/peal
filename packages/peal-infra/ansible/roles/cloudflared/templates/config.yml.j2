# Managed by Ansible (peal-infra). The tunnel's routes, read in order: the
# first rule whose host name and path match a request serves it. cloudflared
# matches paths after resolving dot segments and repeated slashes.
#
# A rule with `access` refuses any request without a valid Cloudflare Access
# token for that application, on top of the Access application at the edge,
# which has to exist too (README.md, "Cloudflare"). Every service listens on
# 127.0.0.1 (compose.production.yaml).
{% set server = 'http://127.0.0.1:' ~ peal_ports.server %}
{% set web = 'http://127.0.0.1:' ~ peal_ports.web %}
{% set services = {'server': server, 'web': web} %}
{% set team = cloudflare_access_team %}
{% if peal_access_everything %}
{% set everything = ', originRequest: {access: {required: true, teamName: ' ~ team ~ ', audTag: [' ~ cloudflare_access_aud.sandbox ~ ']}}' %}
{% else %}
{% set everything = '' %}
{% endif %}
metrics: {{ cloudflared_metrics }}

ingress:
  # Grafana and SSH, for the team only.
  - {hostname: {{ peal_hostnames.grafana }}, service: "http://127.0.0.1:{{ peal_ports.grafana }}", originRequest: {access: {required: true, teamName: {{ team }}, audTag: [{{ cloudflare_access_aud.grafana }}]}}}
  - {hostname: {{ peal_hostnames.ssh }}, service: "ssh://127.0.0.1:22", originRequest: {access: {required: true, teamName: {{ team }}, audTag: [{{ cloudflare_access_aud.ssh }}]}}}
{% if peal_access_everything %}

  # Behind Access throughout, but for what outside services call, the web
  # app's error reports and the pictures emails show, which carry no
  # credentials.
{% for route in peal_access_bypass_paths %}
  - {hostname: {{ peal_hostnames.app }}, path: '{{ route.path }}', service: "{{ services[route.to] }}"}
{% endfor %}
{% else %}

  # The admin, for the team only.
{% for route in peal_access_paths %}
  - {hostname: {{ peal_hostnames.app }}, path: '{{ route.path }}', service: "{{ services[route.to] }}", originRequest: {access: {required: true, teamName: {{ team }}, audTag: [{{ cloudflare_access_aud.admin }}]}}}
{% endfor %}
{% endif %}

  # The app: the server answers /api/* and the OAuth discovery documents, the
  # web app everything else.
  - {hostname: {{ peal_hostnames.app }}, path: "^/+(api/|\\.well-known/oauth-)", service: "{{ server }}"{{ everything }}}
  - {hostname: {{ peal_hostnames.app }}, service: "{{ web }}"{{ everything }}}

{% if peal_site_measurement | default(false) | bool %}
  # What the marketing site, the docs and the blog measure, sent to their
  # own origin: the web app's relay forwards it to PostHog (its site mode,
  # PEAL_POSTHOG_SITE). Nothing else of these host names reaches the web
  # app.
  - {hostname: {{ peal_hostnames.site }}, path: "^/+pulse/+site/", service: "{{ web }}"{{ everything }}}
  - {hostname: {{ peal_hostnames.docs }}, path: "^/+pulse/+site/", service: "{{ web }}"{{ everything }}}

{% endif %}
{% if peal_blog | default(false) | bool %}
{% set blog = 'http://127.0.0.1:' ~ peal_ports.blog %}
  # The blog (packages/peal-blog), on the site's host name: its pages under
  # /blog, and EmDash's admin and API at /_emdash, which Access guards where
  # the host is public, but for the media files its pages show. Never
  # /blog/_emdash: EmDash would take a call there for a public page, and
  # skip its CSRF check. Nothing else of the host goes to the blog, which
  # also answers /robots.txt and /sitemap.xml.
  - {hostname: {{ peal_hostnames.site }}, path: "(?i)^/+blog/+_emdash", service: http_status:404}
  - {hostname: {{ peal_hostnames.site }}, path: "^/+_emdash/+api/+media/+file/", service: "{{ blog }}"{{ everything }}}
{% if peal_access_everything %}
  - {hostname: {{ peal_hostnames.site }}, path: "(?i)^/+_emdash(/|$)", service: "{{ blog }}"{{ everything }}}
{% else %}
  - {hostname: {{ peal_hostnames.site }}, path: "(?i)^/+_emdash(/|$)", service: "{{ blog }}", originRequest: {access: {required: true, teamName: {{ team }}, audTag: [{{ cloudflare_access_aud.blog }}]}}}
{% endif %}
  - {hostname: {{ peal_hostnames.site }}, path: "^/+blog(/|$)", service: "{{ blog }}"{{ everything }}}

{% endif %}
  # The marketing site and the docs: the static image, or the docs server
  # when the docs have their assistant (peal_docs_server) and it answers
  # (routes.yml), which counts each reader by cf-connecting-ip
  # (AUTH_IP_HEADERS).
  - {hostname: {{ peal_hostnames.site }}, service: "http://127.0.0.1:{{ peal_ports.site }}"{{ everything }}}
  - {hostname: {{ peal_hostnames.docs }}, service: "http://127.0.0.1:{{ peal_ports.docs_server if cloudflared_docs_to_server | default(peal_docs_server) | bool else peal_ports.docs }}"{{ everything }}}

{% if peal_short_link_hostname %}

  # Short links: Cloudflare's edge rewrites /<code> to /api/l/<code>
  # (packages/peal-infra/pulumi, src/link-domain.ts). The server gets that
  # path alone, seven letters and digits, and the host answers 404 to
  # anything else, so no path on it reaches the rest of the stack.
  - {hostname: {{ peal_short_link_hostname }}, path: "^/api/l/[0-9A-Za-z]{7}$", service: "{{ server }}"{{ everything }}}
  - {hostname: {{ peal_short_link_hostname }}, service: http_status:404}
{% endif %}

  # Anything else the tunnel receives.
  - service: http_status:404
