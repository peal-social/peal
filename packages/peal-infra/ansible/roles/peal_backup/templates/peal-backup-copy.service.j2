# Managed by Ansible (peal-infra). Copies the backups into the backup copy's
# bucket, which a bucket lock keeps for {{ peal_backup_copy_lock_days }} days whatever
# this server's keys do (README.md, "The backup copy"). Runs after each
# backup that succeeded and from its daily timer, never during a backup.
# It runs as a user of its own, which systemd makes for each run: systemd,
# as root, reads the credentials file, which only root may read, and hands
# the run a copy of it alone.
[Unit]
Description=Copy the Peal database's backups to the locked bucket
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=true
LoadCredential=credentials:{{ peal_root }}/credentials.env
# Plain settings; the keys are read by name from the credentials.
Environment=PEAL_BACKUP_COPY_ENDPOINT=https://{{ peal_backup_endpoint }}
Environment=PEAL_BACKUP_COPY_REGION={{ (peal_settings | default({})).get('PGBACKREST_REPO1_S3_REGION', 'auto') }}
Environment=PEAL_BACKUP_COPY_SOURCE_BUCKET={{ peal_backup_bucket }}
Environment=PEAL_BACKUP_COPY_SOURCE_PATH={{ peal_backup_path }}
Environment=PEAL_BACKUP_COPY_BUCKET={{ peal_backup_copy_bucket }}
Environment=PEAL_BACKUP_COPY_CREDENTIALS=%d/credentials
Environment=PEAL_BACKUP_COPY_LOCK_DAYS={{ peal_backup_copy_lock_days }}
Environment=PEAL_BACKUP_COPY_REFRESH_DAYS={{ peal_backup_copy_refresh_days }}
Environment=PEAL_BACKUP_COPY_MAX_RUN_HOURS=12
{% if peal_backup_copy_trust_after %}
# After an incident (the restore runbook, "The backup copy"): no run the
# store wrote before this is trusted.
Environment=PEAL_BACKUP_COPY_TRUST_AFTER={{ peal_backup_copy_trust_after }}
{% endif %}
Environment=PEAL_BACKUP_COPY_OTLP_URL=http://127.0.0.1:{{ peal_ports.otlp_http }}/v1/metrics
Environment=PEAL_BACKUP_COPY_REPORT_RETRIES={{ peal_backup_report_retries }}
Environment=PEAL_BACKUP_COPY_REPORT_RETRY_DELAY={{ peal_backup_report_retry_delay }}
# The backups' lock: pgBackRest rewrites backup.info as a backup ends.
# tmpfiles.d makes its file at boot (peal-backup.conf, 0644); root makes it
# again here, readable by all whatever the umask, and the run's user opens
# it to read alone.
ExecStartPre=+/usr/bin/touch /run/peal-backup.lock
ExecStartPre=+/usr/bin/chmod 0644 /run/peal-backup.lock
ExecStart=/usr/bin/flock /run/peal-backup.lock /usr/bin/python3 -I /usr/local/sbin/peal-backup-copy copy
# A run that ends otherwise than in success, in Python or not (flock, the
# memory or the time limit), reports its failure.
ExecStopPost=/usr/bin/python3 -I /usr/local/sbin/peal-backup-copy failed
# The index's time is trusted up to this long after the run's name
# (PEAL_BACKUP_COPY_MAX_RUN_HOURS): a run copies at 20 MB/s or more, so 12
# hours take a repository of 800 GB from nothing at least; a larger one
# needs a longer limit, in both.
TimeoutStartSec=12h
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
