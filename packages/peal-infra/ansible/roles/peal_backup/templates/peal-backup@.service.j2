# Managed by Ansible (peal-infra). One backup of the Peal database: %i is
# full, diff or incr.
[Unit]
Description=Back the Peal database up (%i)
Requires=docker.service
After=docker.service
{% if peal_backup_copy | bool %}
# Then the backup copy (peal-backup-copy.service), once this one succeeded.
OnSuccess=peal-backup-copy.service
{% endif %}

[Service]
Type=oneshot
# The full and the differential backups are two units: one waits for the
# other rather than meet pgBackRest's lock and report a failure.
ExecStart=/usr/bin/flock /run/peal-backup.lock /usr/local/sbin/peal-backup %i
# A backup that ends otherwise than in success, in the script or not (flock,
# a signal), reports its failure; the script's own report may come first.
ExecStopPost=/bin/sh -c 'test "$$SERVICE_RESULT" = success || exec /usr/local/sbin/peal-backup %i --failed'
Nice=10
IOSchedulingClass=idle
