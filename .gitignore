# Dependencies and builds
node_modules/
dist/
# The site's build for the end-to-end run (nx run peal-site:build-e2e).
dist-e2e/
build/
.next/
.astro/
.emdash/
.react-email/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# Generated from the contract: Nx rebuilds them (peal-contract:openapi, peal-sdk:spec)
packages/peal-contract/openapi.json
packages/peal-sdk/openapi.json
# Libraries leave their dependencies' versions to the projects that install them
packages/peal-sdk/php/composer.lock
packages/peal-sdk/ruby/Gemfile.lock
# Maven's build of the Java SDK, which Fern's .gitignore (written for Gradle) keeps
packages/peal-sdk/java/target/

# Tool caches and local state
.nx/
.venv/
__pycache__/
.ansible/
.e2e/
.cache/
# Claude Code's local state and worktrees; its shared settings (Trail-code's
# SessionStart hook) are committed
/.claude/*
!/.claude/settings.json
*.log
.idea/
.vscode/
.DS_Store
*.swp
*~

# Secrets and local data
.env*
!.env.example
vault.yml
*.pem
*.key
*.p12
.local/
# A host's settings that stay on the machine running Ansible (peal-infra README)
packages/peal-infra/ansible/inventory/host_vars/*/local.yml
